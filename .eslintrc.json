{
  "extends": "airbnb-base",
  "env": {
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "window": true,
    "dayjs": true
  },
  "rules": {
    "semi": [
      2,
      "never"
    ],
    "comma-dangle": [
      "error",
      "never"
    ],
    "no-param-reassign": [
      0
    ],
    "func-names": [
      0
    ],
    "import/no-extraneous-dependencies": [
      0
    ],
    "import/no-unresolved": [
      2,
      {
        "ignore": [
          "esm-dayjs"
        ]
      }
    ],
    "import/extensions": [
      0
    ]
  }
}
